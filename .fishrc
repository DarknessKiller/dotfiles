export GOPATH="$HOME/go"
export PATH="$GOPATH/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
export SSH_AUTH_SOCK=$HOME/.bitwarden-ssh-agent.sock
export EDITOR=nvim

## My Abbreviations
# Clear command history
abbr -a hc 'history clear'
abbr -a hcs 'history clear-session'

# Timestamp helper
abbr -a ts 'date "+%Y%m%d-%H%M%S"'

# Editor shortcuts
abbr -a vim 'nvim'
abbr -a vi 'nvim'

## Git Abbreviations
abbr -a gs 'git status'
abbr -a ga 'git add .'
abbr -a gc 'git commit -m'
abbr -a gp 'git push'
abbr -a gpl 'git pull'
abbr -a gco 'git checkout'
abbr -a gcb 'git checkout -b'
abbr -a gl 'git log --oneline --graph --decorate --all'

# agentic aliases
alias ocweb="tmux new-session -d -s opencode_web 'cd ~; BROWSER=true opencode web --hostname 0.0.0.0'"
alias piweb="tmux new-session -d -s pi_web 'cd ~; pi-web --hostname 0.0.0.0 --port 4097 --no-open'"

source ~/.cache/cwal/colors.fish
# Only needed if you want override shell colors
# sh ~/.cache/cwal/terminal.sh

# Fast Node Manager
fnm env --use-on-cd --shell fish | source